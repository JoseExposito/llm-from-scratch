{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Base model (10M) - Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/llm_from_scratch/main.py",
            "args": [
                "--configuration", "base-model-10M",
                "--mode", "training",
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "${command:python.interpreterPath}"
        },
        {
            "name": "Base model (10M) - Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/llm_from_scratch/main.py",
            "args": [
                "--configuration", "base-model-10M",
                "--mode", "inference",
                "--start-context", "Once upon a"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "python": "${command:python.interpreterPath}"
        },
    ]
}
